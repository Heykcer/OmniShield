APP_NAME=OmniShield Unified Security Engine
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_KEY=
MAX_UPLOAD_BYTES=10485760
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

 
# 1. MongoDB Database Connection
# To use MongoDB Atlas, replace <db_username>, <db_password>, and <cluster-url>
# Example: mongodb+srv://admin:securepass123@omnishield-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/?retryWrites=true&w=majority&appName=OmniShield

# 2. Google Gemini (Explainable AI)
# This powers the natural language XAI summaries on the dashboard.
# You can generate a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Authentication & Security (Upcoming JWT implementation)
# Required for secure User Login, Registration, and Session management.
# Generate a secure random string by running `openssl rand -hex 32` in your terminal.
JWT_SECRET_KEY=your_super_secure_random_jwt_secret_key
JWT_ALGORITHM=HS256
